  },
  "dataColors": [
    "#CCC6B8",
    "#FDC300",
    "#0F4C81",
    "#60A3BD",
    "#009F57",
    "#C33848",
    "#AE6749",
    "#8A7F9A",
    "#C8C8C8",
    "#F0F0F0"
  ],
  "bad": "#FFFFFF",
  "neutral": "#AFD1DE",
  "good": "#60A3BD",
  "minimum": "#D26A75",
  "center": "#FFFFFF",
  "maximum": "#40B881",
  "foreground": "#21282B",
  "visualStyles": {
    "*": {
      "*": { 
  "filterCard": [
          {
            "$id": "Applied",
            "textSize": 10,
            "backgroundColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "#21282B"
              }
            },
            "transparency": 0
          },
          {
            "$id": "Available",
            "textSize": 10,
            "foregroundColor": {
              "solid": {
                "color": "#21282B"
              }
            }
          }
        ],
        "border": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "show": false
          }
        ],
        "outspacePane": [
          {
            "headerSize": 10,
            "checkboxAndApplyColor": {
              "solid": {
                "color": "#21282B"
              }
            }
          }
        ]
      }
    },
      "page": { 
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ]
      }
    },  
    "actionButton": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "icon": [
          {
            "$id": "default",
            "lineColor": { "solid": { "color": "#21282B" } },
            "lineWeight": 2
          },
          {
            "$id": "hover",
            "lineColor": { "solid": { "color": "#21282B" } },
            "lineWeight": 2
          },
          {
            "$id": "selected",
            "lineColor": { "solid": { "color": "#21282B" } },
            "lineWeight": 2
          }
        ],
        "textState": [
          {
            "$id": "default",
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 12,
            "fontColor": { "solid": { "color": "#919395" } }
          },
          {
            "$id": "hover",
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 12,
            "fontColor": { "solid": { "color": "#21282B" } }
          },
          {
            "$id": "selected",
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 12,
            "fontColor": { "solid": { "color": "#21282B" } }
          }
        ],
        "fill": [
          {
            "$id": "default",
            "show": false
          },
          {
            "$id": "hover",
            "show": true,
            "fillColor": { "solid": { "color": "#919395" } },
            "transparency": 70
          },
          {
            "$id": "selected",
            "show": true,
            "fillColor": { "solid": { "color": "#919395" } },
            "transparency": 70
          }
        ],
        "shape": [
          {
            "$id": "default",
            "type": "rectangle"
          },
          {
            "$id": "hover",
            "type": "snipRoundRectangle",
            "roundTopRight": 25
          },
          {
            "$id": "selected",
            "type": "snipRoundRectangle",
            "roundTopRight": 25
          }
        ]
      }
    },
     "bookmarkNavigator": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "outline": [
            { "show": false }
        ],
         "fill": [
          {
            "$id": "default",
            "show": false
          },
          {
            "$id": "hover",
            "show": true,
            "fillColor": { "solid": { "color": "#919395" } },
            "transparency": 70
          },
          {
            "$id": "selected",
            "show": true,
            "fillColor": { "solid": { "color": "#919395" } },
            "transparency": 70
          }
        ],
        "shape": [
          {
            "$id": "default",
            "tileShape": "tabRoundCorner",
            "roundTopRight": 25
          },
          {
            "$id": "hover",
            "tileShape": "tabRoundCorner",
            "roundTopRight": 25
          },
          {
            "$id": "selected",
            "tileShape": "tabRoundCorner",
            "roundTopRight": 25
          }
        ],
        "text": [
          {
            "$id": "default",
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 12,
            "fontColor": { "solid": { "color": "#919395" } }, 
            "bold": false,
            "italic": false,
            "underline": false
          },
          {
            "$id": "hover",
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 12,
            "fontColor": { "solid": { "color": "#21282B" } } ,
            "bold": false,
            "italic": false,
            "underline": false
          },
          {
            "$id": "selected",
            "show": true,
            "fontFamily": "Segoe UI",
            "fontSize": 12,
            "fontColor": { "solid": { "color": "#21282B" } } ,
            "bold": false,
            "italic": false,
            "underline": false
          }
        ]
      }
    }
  ,
    "slicer": {
            "*": {
              "background": [{
                    "show": false
                }]
              , "visualHeader": [{
                "show": false
                  }]
              ,     "title": [{
                    "show": true,
                    "fontFamily": "Segoe UI",
                    "fontSize": 14,
                    "fontColor": { "solid": { "color": "#21282B" } },
                    "bold": false,
                    "italic": false
                }],
                "header": [{
                    "show": true,
                    "fontFamily": "Segoe UI",
                    "fontSize": 14,
                    "fontColor": { "solid": { "color": "#21282B" } },
                    "bold": false,
                    "italic": false

                "subtitle": [{
                    "show": true,
                    "fontFamily": "Segoe UI",
                    "fontSize": 10,
                    "fontColor": { "solid": { "color": "#919395" } },
                    "bold": false,
                    "italic": false
                }],
                "dataLabels": [{
                        "fontFamily": "Segoe UI",
                        "fontSize": 32,
                        "color": { "solid": { "color": "#21282B" } }
                    }],
                "fontFamily": "Segoe UI",
                "fontSize": 32,
                "color": { "solid": { "color": "#21282B" } },
                "card": [{
                    "barShow": false
                }],
                 "cardTitle": [{
                  "color": { "solid": { "color": "#21282B" } },
                  "fontFamily": "Segoe UI",
                    "fontSize": 32

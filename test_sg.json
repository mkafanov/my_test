{
  "name": "Styleguide Лемана ПРО",
  "textClasses": {
    "label": {
      "fontFace": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
      "color": "#21282B"
    },
    "callout": {
      "fontFace": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
      "fontSize": 24,
      "color": "#21282B"
    },
    "title": {
      "fontFace": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
      "fontSize": 14,
      "color": "#21282B"

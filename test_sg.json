                    "fontSize": 12,
                    "fontColor": { "solid": { "color": "#919395" } }
                }],
                "slider": [{
                    "show": true,
                    "color": { "solid": { "color": "#919395" } }
                }]
            }
        },
        "multiRowCard": {
            "*": {
              "background": [{
                    "show": false
